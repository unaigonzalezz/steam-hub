{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "library-dial",
  "items": [
    {
      "key": "art",
      "type": "pixmap",
      "rect": [0, 0, 200, 50],
      "zOrder": 0
    },
    {
      "key": "name",
      "type": "text",
      "rect": [4, 50, 192, 22],
      "zOrder": 1,
      "alignment": "center",
      "color": "#ffffff",
      "text-overflow": "ellipsis",
      "font": {
        "size": 15,
        "weight": 600
      }
    },
    {
      "key": "position",
      "type": "text",
      "rect": [4, 72, 192, 26],
      "zOrder": 1,
      "alignment": "center",
      "color": "#ffffff",
      "font": {
        "size": 13,
        "weight": 500
      }
    }
  ]
}
